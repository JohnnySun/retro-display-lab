{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retro-display-lab.invalid/schemas/cgb001/color-model-v1.json",
  "title": "CGB-001 fixed-angle D65 color model v1",
  "description": "Records a fitted color reduction and generated LUT without relabeling interpolation as direct measurement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "colorModelId", "modelId", "classification", "inputRecord", "sourceOfRecord", "referenceCondition", "blackPolicy", "interactionPolicy", "normalization", "runtimeLut", "validation", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "colorModelId": { "type": "string", "minLength": 1 },
    "modelId": { "const": "nintendo-cgb-001-period-reconstruction" },
    "classification": { "enum": ["derived", "measured-constrained-derived"] },
    "evidenceIds": { "type": "array", "contains": { "const": "CGB-HCS-REFLECTANCE-2026" }, "items": { "type": "string", "pattern": "^CGB-" } },
    "inputRecord": { "type": "string", "minLength": 1 },
    "sourceOfRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "ods", "txt"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "ods": { "type": "string", "minLength": 1 },
        "txt": { "type": "string", "minLength": 1 }
      }
    },
    "referenceCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["illuminant", "illuminationAngleDegrees", "viewAngleDegrees", "encoding"],
      "properties": {
        "illuminant": { "const": "CIE D65" },
        "illuminationAngleDegrees": { "const": 45 },
        "viewAngleDegrees": { "const": 0 },
        "encoding": { "const": "sRGB D65" },
        "spectralIntegrationRangeNm": { "const": [380, 730] },
        "runtimeAngleModel": { "const": false }
      }
    },
    "blackPolicy": { "type": "object", "additionalProperties": true, "required": ["id", "description"] },
    "interactionPolicy": { "type": "object", "additionalProperties": true, "required": ["id", "description"] },
    "normalization": { "type": "object", "additionalProperties": true, "required": ["codeMappingPolicy", "monotonicPolicy", "repairReport"] },
    "runtimeLut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "domain", "encoding", "sha256"],
      "properties": {
        "dimensions": { "const": [32, 32, 32] },
        "domain": { "const": "continuous RGB555 code space" },
        "encoding": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "validation": { "type": "object", "additionalProperties": true, "required": ["status", "report"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
